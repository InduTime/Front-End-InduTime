# URL base compartilhada pelas chamadas do frontend (máquinas, operações e usuários).
# Quando o backend estiver no mesmo computador do frontend:
REACT_APP_API_URL=http://localhost:8083

# Quando o backend estiver em outro computador da rede, substitua pelo IP do servidor:
# REACT_APP_API_URL=http://IP_DO_SERVIDOR:8083
